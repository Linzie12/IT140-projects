# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, SET, ADD, or similar terms.

START get_item

    # TODO 1: Identify the information the get-item process needs.
    # Consider the current room, item in that room, and player's inventory.
    INPUT item
    INPUT current_room
    INPUT inventory
    # TODO 2: Prompt for and receive the player's get-item command.
    DISPLAY "Enter an item to get."
    INPUT item
    # TODO 3: Validate whether the requested item is available in the current
    # room. Show the decision clearly.
    IF item IN inventory THEN

    # TODO 4: Describe what happens when the item request is valid.
    # Include the inventory update and player output.
        DISPLAY "Item already in inventory"
    ELSE
        IF item IN current_room THEN
            ADD intem TO inventory
            DISPLAY "Item added to inventory"
    # TODO 5: Describe what happens when the item request is invalid.
    # Include the output the player should receive.
        ELSE
            DISPLAY "No such item in this room"
        ENDIF
    ENDIF
    # TODO 6: Show how the process returns to or continues the larger gameplay
    # loop after the command is handled.
    RETURN inventory
END get_item


